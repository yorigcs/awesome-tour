{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "awesome-tour",
  "homepage": "https://yorigcs.github.io/awesome-tour",
  "items": [
    {
      "name": "tour",
      "type": "registry:component",
      "title": "Tour",
      "description": "A styled product tour: overlay, spotlight and a composable card with progress, navigation and step dots.",
      "dependencies": ["@awesome-tour/react", "class-variance-authority", "lucide-react"],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "src/components/awesome-tour/tour.tsx",
          "type": "registry:component",
          "target": "components/awesome-tour/tour.tsx"
        }
      ],
      "cssVars": {
        "light": {
          "tour-overlay-color": "oklch(0.145 0.014 285 / 0.55)"
        },
        "dark": {
          "tour-overlay-color": "oklch(0 0 0 / 0.65)"
        }
      },
      "css": {
        "@layer base": {
          "[data-tour-content-wrapper]": {
            "z-index": "51"
          }
        }
      }
    },
    {
      "name": "tour-motion",
      "type": "registry:component",
      "title": "Tour (motion)",
      "description": "The tour card and overlay animated with motion: a spring spotlight that glides between targets.",
      "dependencies": ["@awesome-tour/react", "@awesome-tour/motion", "motion"],
      "registryDependencies": ["{{REGISTRY_URL}}/tour.json"],
      "files": [
        {
          "path": "src/components/awesome-tour/tour-motion.tsx",
          "type": "registry:component",
          "target": "components/awesome-tour/tour-motion.tsx"
        }
      ]
    },
    {
      "name": "checklist",
      "type": "registry:component",
      "title": "Checklist",
      "description": "An onboarding checklist card with progress, completion states and a dismiss/restore flow.",
      "dependencies": ["@awesome-tour/react", "lucide-react"],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "src/components/awesome-tour/checklist.tsx",
          "type": "registry:component",
          "target": "components/awesome-tour/checklist.tsx"
        }
      ]
    },
    {
      "name": "hotspot",
      "type": "registry:component",
      "title": "Hotspot",
      "description": "A pulsing beacon pinned to an element that opens a hint popover.",
      "dependencies": ["@awesome-tour/react", "lucide-react"],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "src/components/awesome-tour/hotspot.tsx",
          "type": "registry:component",
          "target": "components/awesome-tour/hotspot.tsx"
        }
      ]
    },
    {
      "name": "announcement",
      "type": "registry:component",
      "title": "Announcement",
      "description": "Banner, toast and modal announcements with display rules, snooze and auto-dismiss.",
      "dependencies": ["@awesome-tour/react", "lucide-react"],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "src/components/awesome-tour/announcement.tsx",
          "type": "registry:component",
          "target": "components/awesome-tour/announcement.tsx"
        }
      ]
    },
    {
      "name": "survey",
      "type": "registry:component",
      "title": "Survey",
      "description": "An NPS / CSAT / CES survey card with conditional follow-up questions.",
      "dependencies": ["@awesome-tour/react", "lucide-react"],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "src/components/awesome-tour/survey.tsx",
          "type": "registry:component",
          "target": "components/awesome-tour/survey.tsx"
        }
      ]
    },
    {
      "name": "launcher",
      "type": "registry:component",
      "title": "Help launcher",
      "description": "A floating help button that opens a resource center to replay tours and find links.",
      "dependencies": ["@awesome-tour/react", "lucide-react"],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "src/components/awesome-tour/launcher.tsx",
          "type": "registry:component",
          "target": "components/awesome-tour/launcher.tsx"
        }
      ]
    }
  ]
}
