---
import { ArrowRight } from 'lucide-react';

interface Props {
  title: string;
  href: string;
  description?: string;
}
const { title, href, description } = Astro.props;
---

<a
  href={href}
  class="not-prose group flex items-start gap-3 rounded-sm border-2 border-ink p-4 transition-colors hover:bg-marker hover:text-marker-ink"
>
  <span class="min-w-0 flex-1">
    <span class="block font-bold">{title}</span>
    {description && <span class="mt-1 block text-[0.9375rem] leading-relaxed text-ink-2 group-hover:text-marker-ink">{description}</span>}
  </span>
  <ArrowRight className="mt-1 size-4 shrink-0 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
</a>
