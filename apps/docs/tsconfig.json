{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@awesome-tour/core/json": ["../../packages/core/src/json.ts"],
      "@awesome-tour/core/adapters": ["../../packages/core/src/adapters.ts"],
      "@awesome-tour/core": ["../../packages/core/src/index.ts"],
      "@awesome-tour/react/surfaces": ["../../packages/react/src/surfaces.ts"],
      "@awesome-tour/react": ["../../packages/react/src/index.ts"],
      "@awesome-tour/motion": ["../../packages/motion/src/index.ts"],
      "@awesome-tour/devtools": ["../../packages/devtools/src/index.ts"],
      "@awesome-tour/three": ["../../packages/three/src/index.ts"],
      "@awesome-tour/elements": ["../../packages/elements/src/index.ts"],
      "@awesome-tour/elements/define": ["../../packages/elements/src/define.ts"],
      "@loopwork": ["../../examples/loopwork/src/index.ts"],
      "@/*": ["../../registry/src/*"],
      "~/*": ["./src/*"]
    }
  }
}
