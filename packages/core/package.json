{
  "name": "@awesome-tour/core",
  "version": "0.1.0",
  "description": "Headless, framework-agnostic engine for product tours and onboarding.",
  "license": "MIT",
  "author": "Yor\u00ed",
  "homepage": "https://yorigcs.github.io/awesome-tour/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorigcs/awesome-tour.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/yorigcs/awesome-tour/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./json": {
      "import": {
        "types": "./dist/json.d.ts",
        "default": "./dist/json.js"
      },
      "require": {
        "types": "./dist/json.d.cts",
        "default": "./dist/json.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters.d.ts",
        "default": "./dist/adapters.js"
      },
      "require": {
        "types": "./dist/adapters.d.cts",
        "default": "./dist/adapters.cjs"
      }
    },
    "./schema.json": "./schema/tour.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "keywords": [
    "tour",
    "onboarding",
    "product-tour",
    "walkthrough",
    "headless",
    "react",
    "a11y"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
