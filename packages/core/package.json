{
  "name": "@awesome-tour/core",
  "version": "0.1.0",
  "description": "Headless, framework-agnostic engine for product tours and onboarding.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tour",
    "onboarding",
    "product-tour",
    "walkthrough",
    "headless",
    "react",
    "a11y"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
