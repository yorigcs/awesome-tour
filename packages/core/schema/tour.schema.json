{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yorigcs.github.io/awesome-tour/schema/tour.schema.json",
  "title": "awesome-tour tour",
  "description": "A product tour as data, for `fromJSON` from `@awesome-tour/core/json`. Functions are referenced by action name.",
  "type": "object",
  "required": ["id", "steps"],
  "additionalProperties": false,
  "$defs": {
    "target": {
      "description": "A CSS selector, an anchor, or several of them.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/anchor" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/anchor" }] }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "required": ["anchor"],
      "additionalProperties": false,
      "properties": { "anchor": { "type": "string", "minLength": 1 } }
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "description": "Name of a function passed in `actions`."
    },
    "advanceOn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "signal": { "type": "string" },
        "delay": { "type": "number", "minimum": 0 },
        "when": { "$ref": "#/$defs/action" },
        "to": { "type": "string" }
      }
    },
    "missing": { "enum": ["wait", "skip", "center", "error"] },
    "step": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "target": { "oneOf": [{ "$ref": "#/$defs/target" }, { "type": "null" }] },
        "route": { "type": "string" },
        "side": { "enum": ["top", "right", "bottom", "left"] },
        "align": { "enum": ["start", "center", "end"] },
        "modal": { "type": "boolean" },
        "interactive": { "type": "boolean" },
        "scroll": { "type": "boolean" },
        "onTargetMissing": { "$ref": "#/$defs/missing" },
        "targetTimeout": { "type": "number", "minimum": 0 },
        "when": { "$ref": "#/$defs/action" },
        "next": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" },
            {
              "type": "object",
              "required": ["action"],
              "additionalProperties": false,
              "properties": { "action": { "$ref": "#/$defs/action" } }
            }
          ]
        },
        "beforeEnter": { "$ref": "#/$defs/action" },
        "afterLeave": { "$ref": "#/$defs/action" },
        "canNext": { "$ref": "#/$defs/action" },
        "advanceOn": {
          "oneOf": [
            { "$ref": "#/$defs/advanceOn" },
            { "type": "array", "items": { "$ref": "#/$defs/advanceOn" } }
          ]
        },
        "meta": { "type": "object" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "modal": { "type": "boolean" },
    "layer": { "enum": ["blocking", "ambient"] },
    "targetTimeout": { "type": "number", "minimum": 0 },
    "onTargetMissing": { "$ref": "#/$defs/missing" },
    "data": { "type": "object" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": { "$ref": "#/$defs/action" },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "startsAt": { "type": "string" }, "endsAt": { "type": "string" } }
        },
        "frequency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "once": { "type": "boolean" },
            "maxShows": { "type": "integer", "minimum": 1 },
            "cooldownMs": { "type": "number", "minimum": 0 }
          }
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "route": { "type": "string" },
            "signal": { "type": "string" },
            "event": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": { "type": { "type": "string" }, "target": { "$ref": "#/$defs/target" } }
            },
            "delay": { "type": "number", "minimum": 0 },
            "targetVisible": { "$ref": "#/$defs/target" }
          }
        },
        "priority": { "type": "number" }
      }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
  }
}
