{
  "name": "@awesome-tour/react",
  "version": "0.1.0",
  "description": "Unstyled, accessible React primitives for product tours and onboarding.",
  "license": "MIT",
  "author": "Yor\u00ed",
  "homepage": "https://yorigcs.github.io/awesome-tour/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorigcs/awesome-tour.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/yorigcs/awesome-tour/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./surfaces": {
      "import": {
        "types": "./dist/surfaces.d.ts",
        "default": "./dist/surfaces.js"
      },
      "require": {
        "types": "./dist/surfaces.d.cts",
        "default": "./dist/surfaces.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tour",
    "onboarding",
    "product-tour",
    "walkthrough",
    "headless",
    "react",
    "a11y"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@awesome-tour/core": "workspace:^",
    "@floating-ui/react-dom": "^2.1.9"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
