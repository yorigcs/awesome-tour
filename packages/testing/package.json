{
  "name": "@awesome-tour/testing",
  "version": "0.1.0",
  "description": "Test helpers for awesome-tour: Playwright fixture, React Testing Library render, layout mocks and a memory router.",
  "license": "MIT",
  "author": "Yor\u00ed",
  "homepage": "https://yorigcs.github.io/awesome-tour/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorigcs/awesome-tour.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/yorigcs/awesome-tour/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/playwright.d.ts",
        "default": "./dist/playwright.js"
      },
      "require": {
        "types": "./dist/playwright.d.cts",
        "default": "./dist/playwright.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tour",
    "onboarding",
    "testing",
    "playwright",
    "vitest"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@awesome-tour/core": "workspace:^"
  },
  "peerDependencies": {
    "@awesome-tour/react": "workspace:^",
    "@playwright/test": ">=1.40",
    "@testing-library/react": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@awesome-tour/react": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@awesome-tour/react": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
