{
  "name": "@awesome-tour/devtools",
  "version": "1.0.0",
  "description": "Devtools panel for awesome-tour: inspect tours, jump between steps, check target health and watch events.",
  "license": "MIT",
  "author": "Yor\u00ed",
  "homepage": "https://yorigcs.github.io/awesome-tour/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorigcs/awesome-tour.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/yorigcs/awesome-tour/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tour",
    "onboarding",
    "devtools"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@awesome-tour/react": "workspace:^",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@awesome-tour/core": "workspace:^",
    "@awesome-tour/react": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
